[
  {
    "rule_code": "R001",
    "rule_name": "预付款比例过高",
    "risk_level": "high",
    "rule_status": "enabled",
    "match_mode": "value_compare",
    "match_text": {
      "field": "clause.payment",
      "pattern": "预付款?(?:比例|金额)?[^%\\d]{0,20}(\\d+(?:\\.\\d+)?)\\s*%",
      "threshold": 30,
      "operator": ">"
    },
    "suggestion_text": "预付款比例超过公司 30% 上限,建议压降预付款比例,或要求对方提供等额履约保函。",
    "description": "付款条款中预付款比例超过 30% 即命中"
  },
  {
    "rule_code": "R002",
    "rule_name": "付款周期过长",
    "risk_level": "medium",
    "rule_status": "enabled",
    "match_mode": "value_compare",
    "match_text": {
      "field": "clause.payment",
      "pattern": "(?:验收合格后|验收通过后|验收后|交付后)[^日\\d]{0,15}(\\d{1,3})\\s*日",
      "threshold": 45,
      "operator": ">"
    },
    "suggestion_text": "尾款付款周期超过 45 天,建议缩短付款周期,降低资金占用与逾期风险。",
    "description": "验收/交付后付款周期超过 45 天即命中"
  },
  {
    "rule_code": "R003",
    "rule_name": "存在自动续约条款",
    "risk_level": "medium",
    "rule_status": "enabled",
    "match_mode": "keyword",
    "match_text": {
      "field": "full_text",
      "keywords": ["自动续期", "自动续约", "自动顺延"],
      "match_any": true
    },
    "suggestion_text": "合同存在自动续约条款,请确认是否接受自动续期安排,建议增加期满前书面通知即可终止的约定。",
    "description": "合同全文出现自动续约类表述即命中"
  },
  {
    "rule_code": "R004",
    "rule_name": "违约责任不对等",
    "risk_level": "medium",
    "rule_status": "enabled",
    "match_mode": "regex",
    "match_text": {
      "field": "clause.breach",
      "pattern": "甲方[^。\\n]{0,40}违约金(?!.{0,60}乙方[^。\\n]{0,40}违约金)",
      "hit_if": "match"
    },
    "suggestion_text": "违约责任仅约定甲方单方承担,建议补充乙方违约责任条款,保证双方权责对等。",
    "description": "违约条款仅约定甲方违约金、未约定乙方违约责任即命中"
  },
  {
    "rule_code": "R005",
    "rule_name": "管辖或仲裁地不利于我方",
    "risk_level": "medium",
    "rule_status": "enabled",
    "match_mode": "regex",
    "match_text": {
      "field": "clause.dispute",
      "pattern": "(?:管辖|仲裁)[^。\\n]{0,20}(?:乙方|对方|卖方|供应商)所在地|(?:乙方|对方|卖方|供应商)所在地[^。\\n]{0,20}(?:管辖|仲裁)",
      "hit_if": "match"
    },
    "suggestion_text": "争议管辖/仲裁地约定在对方所在地,建议争取约定在我方所在地法院或中立仲裁机构。",
    "description": "争议解决条款约定在乙方/对方所在地管辖或仲裁即命中"
  },
  {
    "rule_code": "R006",
