# ===== 数据库 =====
# SQLite(演示默认): sqlite:///./data/app.db
# MySQL(生产): mysql+pymysql://user:pass@host:3306/reason_analyze?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db

# ===== 文件存储根目录(uploads/ exports/ workspace/ 三个子目录) =====
STORAGE_ROOT=./storage

# ===== 认证中心(mock OAuth2, 见 ../auth-service) =====
AUTH_SERVICE_BASE_URL=http://localhost:8001
OAUTH_CLIENT_ID=analysis-client
OAUTH_CLIENT_SECRET=analysis-client-secret

# ===== 会话 JWT =====
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=24

# ===== 对外地址 =====
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# ===== 日志 =====
LOG_DIR=./logs
LOG_LEVEL=INFO

# ===== LLM(OpenAI 兼容协议,默认 DeepSeek;也可改 Qwen/GLM;此处的 api_key 仅作环境兜底,
#        推荐登录后通过管理端 system_configs 配置并热更新) =====
LLM_API_KEY=
